{
  "name": "pi-lpt-herdr-subagents",
  "version": "1.3.0",
  "description": "LPT-owned Herdr subagents for reliable Pi lifecycle, result, and control foundations",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "subagents",
    "agents",
    "worktrees",
    "orchestration"
  ],
  "license": "MIT",
  "author": {
    "name": "Giuseppe Rodriguez",
    "url": "https://github.com/giuseppecrj"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-lpt-herdr-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-lpt-herdr-subagents/issues"
  },
  "homepage": "https://github.com/alexshpunt/pi-lpt-herdr-subagents#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "changelog": "auto-changelog",
    "lint": "oxlint pi-extension test",
    "test": "node --experimental-strip-types --test test/test.ts test/launch.test.ts test/lineage.test.ts test/runtime-routing.test.ts test/release-workflow.test.ts test/workflow.test.ts test/settled-contract.test.ts test/settled-observer.test.ts test/public-subagent-tree-api.test.ts test/package-skill.test.js test/result-file.test.ts test/delivery-payload.test.ts test/status-framing.test.ts test/delivery-log.test.ts test/delivery-truth.test.ts test/sidecar-ack.test.ts test/delivery-uniformity.test.ts test/delivery-recovery.test.ts test/watchdog.test.ts",
    "test:integration": "node --experimental-strip-types test/integration/run-isolated.ts",
    "test:integration:live": "PI_TEST_LIVE=1 node --experimental-strip-types test/integration/run-isolated.ts",
    "version": "auto-changelog --package && git add CHANGELOG.md"
  },
  "auto-changelog": {
    "commitLimit": false,
    "template": "keepachangelog",
    "unreleased": true
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.4 <0.85.0",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/alexshpunt/pi-lpt-herdr-subagents/main/docs/assets/pi-herdr-agents-gallery.png"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@sinclair/typebox": "^0.34.52",
    "auto-changelog": "^2.6.0",
    "oxlint": "^1.73.0"
  }
}
